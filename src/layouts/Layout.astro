---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { baseUrl } from "../utils";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
	canonicalUrl?: string;
	publishedTime?: string;
	modifiedTime?: string;
	author?: string;
	structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
	title = "ohwire | Notes from a Self-Taught Developer",
	description = "Documenting what breaks, what works, and what I learn building software and AI workflows each week.",
	image = "/images/og/og-home.webp",
	type = "website",
	canonicalUrl = new URL(
		Astro.url.pathname,
		Astro.site || Astro.url,
	).toString(),
	publishedTime,
	modifiedTime,
	author = "ohwire",
	structuredData,
} = Astro.props;

const resolvedImage = image.startsWith("http")
	? image
	: new URL(baseUrl + image, Astro.site || Astro.url).toString();

const siteUrl = Astro.site
	? Astro.site.toString().replace(/\/$/, "")
	: "https://ohwire.xyz";

const defaultSchema = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "ohwire",
		url: siteUrl,
		description:
			"Documenting what breaks, what works, and what I learn building software and AI workflows each week.",
		author: {
			"@type": "Person",
			name: "ohwire",
			url: siteUrl,
			sameAs: ["https://github.com/ohwiredev", "https://x.com/ohwiredev"],
		},
	},
];

const schemaToRender = structuredData
	? Array.isArray(structuredData)
		? [...defaultSchema, ...structuredData]
		: [...defaultSchema, structuredData]
	: defaultSchema;
---

<!doctype html>
<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function () {
        const theme =
          localStorage.getItem("theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        if (theme === "dark") {
          document.documentElement.classList.add("dark");
          document.documentElement.classList.remove("light");
        } else {
          document.documentElement.classList.add("light");
          document.documentElement.classList.remove("dark");
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}/favicon.svg`} />
    <link rel="sitemap" href={`${baseUrl}/sitemap-index.xml`} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="text/markdown"
      href={`${baseUrl}/llms.txt`}
      title="LLM Context"
    />
    <link
      rel="alternate"
      type="text/markdown"
      href={`${baseUrl}/llms-full.txt`}
      title="LLM Full Content Archive"
    />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedImage} />
    <meta property="og:site_name" content="ohwire" />
    {
      type === "article" && publishedTime && (
        <meta property="article:published_time" content={publishedTime} />
      )
    }
    {
      type === "article" && modifiedTime && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {
      type === "article" && author && (
        <meta property="article:author" content={author} />
      )
    }

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={resolvedImage} />

    <!-- Structured Data (JSON-LD) for Search and Answer Engines -->
    {
      schemaToRender.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body
    class="font-body-md text-body-md overflow-x-hidden selection:bg-primary-container selection:text-white"
  >
    <Header />
    <main class="pt-20">
      <slot />
    </main>
    <Footer />
  </body>
</html>


---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowUpRight, BookOpen } from "@lucide/astro";
import Layout from "../../layouts/Layout.astro";
import { baseUrl, getImagePath } from "../../utils";

// Fetch all tools from content collection
const allTools = (await getCollection("tools")).sort(
	(a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Tools | ohwire"
  description="Small, free, open source tools I've built to scratch my own itches. Everything runs in your browser."
  image="/images/og/og-home.webp"
>
  <section
    class="px-margin-mobile md:px-margin-desktop py-12 md:py-20 flex flex-col items-center text-center max-w-container-max mx-auto"
  >
    <h1
      class="font-display-lg text-[40px] leading-12 md:text-display-lg/18 mb-6 opacity-0 animate-fade-up"
    >
      Things I've <span class="text-primary italic">Built</span>
    </h1>
    <p
      class="font-body-lg text-body-lg text-secondary max-w-150 mb-10 opacity-0 animate-fade-up delay-100"
    >
      Small, free, open source tools I built to scratch my own itches. No signups, no watermarks, and everything runs right in your browser.
    </p>
  </section>

  <section
    class="px-margin-mobile md:px-margin-desktop pb-section-gap max-w-container-max mx-auto"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6" id="tools-grid">
      {
        allTools.map((tool) => (
          <article class="reveal h-full">
            <div
              class="spotlight-card h-full relative bg-outline-variant/30 rounded-xl p-px overflow-hidden group/card"
            >
              {/* Spotlight Gradient Background */}
              <div class="spotlight-glow absolute -inset-px opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 pointer-events-none" />

              {/* Inner Content Area */}
              <div class="relative w-full h-full bg-surface-container rounded-[11px] flex flex-col text-left z-10 overflow-hidden">
                {tool.data.image && (
                  <a
                    href={tool.data.liveUrl ?? tool.data.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="block relative aspect-video overflow-hidden border-b border-outline-variant/30"
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <Image
                      class="w-full h-full object-cover object-top transition-transform duration-700 group-hover/card:scale-[1.03]"
                      alt={tool.data.imageAlt || tool.data.title}
                      src={getImagePath(tool.data.image)}
                      width={1200}
                      height={675}
                    />
                  </a>
                )}

                <div class="flex flex-col grow p-6 md:p-8">
                  <div class="flex items-baseline gap-3 mb-2">
                    <h2 class="font-headline-sm text-headline-sm group-hover/card:text-primary transition-colors duration-300">
                      {tool.data.title}
                    </h2>
                    <span class="text-[11px] text-secondary uppercase tracking-widest font-label-sm px-2 py-0.5 rounded-md bg-secondary/10">
                      {tool.data.category}
                    </span>
                  </div>
                  <p class="font-body-md text-body-md text-secondary mb-5">
                    {tool.data.description}
                  </p>

                  {tool.data.stack.length > 0 && (
                    <ul class="flex flex-wrap gap-2 mb-6 list-none p-0">
                      {tool.data.stack.map((tech) => (
                        <li class="text-[12px] font-label-md text-on-surface/80 px-2.5 py-1 rounded-full border border-outline-variant/40">
                          {tech}
                        </li>
                      ))}
                    </ul>
                  )}

                  <div class="mt-auto flex flex-wrap items-center gap-3">
                    {tool.data.liveUrl && (
                      <a
                        href={tool.data.liveUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-1.5 rounded-full bg-primary text-on-primary hover:bg-primary/90 px-5 py-2 font-label-md text-label-md no-underline shadow-md hover:shadow-lg transition-[transform,background-color,box-shadow] duration-150 ease-[var(--ease-custom-out)] active:scale-[0.97] select-none"
                      >
                        Try it
                        <ArrowUpRight class="w-4 h-4" />
                      </a>
                    )}
                    <a
                      href={tool.data.githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 rounded-full border border-outline-variant/50 text-on-surface hover:border-primary hover:text-primary px-5 py-2 font-label-md text-label-md no-underline transition-[transform,color,border-color] duration-150 ease-[var(--ease-custom-out)] active:scale-[0.97] select-none"
                    >
                      <svg
                        class="w-4 h-4"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                      </svg>
                      Source
                    </a>
                    {tool.data.note && (
                      <a
                        href={`${baseUrl}/notes/${tool.data.note}`}
                        class="inline-flex items-center gap-1.5 px-2 py-2 font-label-md text-label-md text-secondary hover:text-primary no-underline transition-colors duration-150"
                      >
                        <BookOpen class="w-4 h-4" />
                        Read the note
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <style>
    .spotlight-glow {
      background: radial-gradient(
        circle at var(--mouse-x, 0px) var(--mouse-y, 0px),
        var(--color-primary),
        transparent 250px
      );
    }

    @media (prefers-reduced-motion: reduce) {
      .spotlight-card,
      .spotlight-glow,
      img {
        /* biome-ignore lint/complexity/noImportantStyles: override required for reduced motion */
        transition: none !important;
      }
    }
  </style>

  <script>
    // Reveal Observer for scroll animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: "0px 0px -50px 0px",
    };

    const observer = new IntersectionObserver((entries) => {
      const currentEntries = entries.filter((e) => e.isIntersecting);

      currentEntries.forEach((entry, index) => {
        // If they are part of a grid, stagger them
        const isGridItem = entry.target.parentElement?.id === "tools-grid";

        setTimeout(
          () => {
            entry.target.classList.add("active");
            observer.unobserve(entry.target);
          },
          isGridItem ? index * 50 : 0,
        );
      });
    }, observerOptions);

    document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));

    // Spotlight Effect
    const initSpotlight = () => {
      const cards = document.querySelectorAll(".spotlight-card");
      if (!cards.length) return;

      let targetX = -1000;
      let targetY = -1000;
      let currentX = -1000;
      let currentY = -1000;

      document.addEventListener("mousemove", (e) => {
        targetX = e.clientX;
        targetY = e.clientY;
      });

      const updateSpotlight = () => {
        currentX += (targetX - currentX) * 0.15;
        currentY += (targetY - currentY) * 0.15;

        for (let i = 0; i < cards.length; i++) {
          const card = cards[i] as HTMLElement;
          const rect = card.getBoundingClientRect();
          const x = currentX - rect.left;
          const y = currentY - rect.top;
          card.style.setProperty("--mouse-x", `${x}px`);
          card.style.setProperty("--mouse-y", `${y}px`);
        }
        requestAnimationFrame(updateSpotlight);
      };

      requestAnimationFrame(updateSpotlight);
    };

    // Run on initial load
    initSpotlight();

    // Run when Astro swaps pages (if view transitions are used later)
    document.addEventListener("astro:page-load", initSpotlight);
  </script>
</Layout>
